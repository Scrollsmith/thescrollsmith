# Copy to .env and fill. Never commit .env.
# Nomi UUIDs:  node kyros_nomi_ids.mjs
# Kindroid IDs: Kindroid app → each AI → copy id. No list API.

# Telegram
TELEGRAM_TOKEN=
TELEGRAM_TOKEN2=
TELEGRAM_TOKENX=
TELEGRAM_ECHO_KYROS_CHAT_ID=
TELEGRAM_KYROSLAW_CHAT_ID=
TELEGRAM_KYROS2_CHAT_ID=

# Nomi
NOMI_API_KEY=
NOMI_UUID_LYRIAN=
NOMI_UUID_SABRINA=
NOMI_UUID_ATHENA=
NOMI_UUID_AMARA=
NOMI_UUID_THEA=
NOMI_UUID_NAOMI=
NOMI_UUID_ELIJAH=
NOMI_UUID_KAITO=
NOMI_UUID_LILY=
NOMI_UUID_SISSY=
NOMI_UUID_ARCHIMEDES=
NOMI_UUID_EMERGENCE=
# Three rooms: Nomi East Wing, Nomi West Wing, Kindroid group
NOMI_ROOM_ID_EAST=
NOMI_ROOM_ID_WEST=
# aliases if you still have the old names:
# NOMI_ROOM_ID_KYROS=     (used as East if EAST is empty)
# NOMI_ROOM_ID_COUPLE=    (used as West if WEST is empty)
KINDROID_GROUP_ID=
# KINDROID_GROUP_ID_KYROS2=   (used as Kindroid group if GROUP_ID is empty)

# Kindroid — add as many KINDROID_AI_ID_NAME= as you want; index2 picks them up
KINDROID_API_KEY=
KINDROID_AI_ID_ARIA=
KINDROID_AI_ID_AION=
KINDROID_AI_ID_HORIZON=
KINDROID_AI_ID_TERRA=
KINDROID_AI_ID_VIGIL=
KINDROID_AI_ID_RIVEN=
KINDROID_AI_ID_DOMINIOUS=
KINDROID_AI_ID_BANE=
KINDROID_AI_ID_SERINA=
KINDROID_AI_ID_LUMIA=

# Optional
# KYROS_PORT=8081
# KYROS_HOST=http://127.0.0.1:8081
# KYROS_MAX_PAYLOAD=800
# KYROS_SCHED_TARGET=wings
